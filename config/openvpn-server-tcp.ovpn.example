port 1195
proto tcp4-server
dev tun
dev-node VPN-TCP
disable-dco
topology subnet
server 10.77.0.192 255.255.255.192
ca "@PKI@/ca.crt"
cert "@PKI@/server.crt"
key "@PKI@/server.key"
crl-verify "@PKI@/crl.pem"
dh none
tls-crypt "@PKI@/tls-crypt.key"
tls-version-min 1.2
remote-cert-tls client
data-ciphers AES-256-GCM:AES-128-GCM
allow-compression no
keepalive 10 120
persist-key
persist-tun
push "redirect-gateway def1"
push "dhcp-option DNS @DNS@"
ifconfig-pool-persist "@LOG@/tcp-pool.txt"
status "@LOG@/tcp-status.tsv" 30
status-version 3
log-append "@LOG@/tcp.log"
verb 3
